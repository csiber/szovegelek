---
import '../styles/global.css';
import { getCurrentUser } from '../lib/auth';
import Logo from '../components/Logo.astro';

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  articleSchema?: Record<string, unknown>;
}

const {
  title,
  description = 'Szövegelek — magyar AI-copywriter KKV-knek. Termékleírás, hirdetés, e-mail, FB-poszt, Instagram-caption magyar nyelven percek alatt. NEM ChatGPT-stílus, hanem szerves magyar mondatok.',
  ogImage = '/og/og-default.png',
  articleSchema,
} = Astro.props;

const fullTitle = title.includes('Szövegelek') ? title : `${title} · Szövegelek`;
const SITE_BASE = Astro.site ?? new URL('https://szovegelek.promnet.hu');
const canonical = new URL(Astro.url.pathname, SITE_BASE).href;
const ogImageAbsolute = ogImage.startsWith('http')
  ? ogImage
  : new URL(ogImage, SITE_BASE).href;

// Cross-brand auth
const user = await getCurrentUser(Astro).catch(() => null);
const PN_LOGIN_BRIDGE = 'https://promnet.hu/app/belepes?next='
  + encodeURIComponent('/api/auth/sso/sz-bridge');

// Schema.org JSON-LD — SoftwareApplication + Organization
const websiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'Szövegelek',
  alternateName: 'Szövegelek — magyar AI-copywriter',
  url: 'https://szovegelek.promnet.hu',
  description,
  inLanguage: 'hu-HU',
  publisher: {
    '@type': 'Organization',
    name: 'Szövegelek (PromNET-család)',
    url: 'https://szovegelek.promnet.hu',
    logo: {
      '@type': 'ImageObject',
      url: 'https://szovegelek.promnet.hu/favicon.svg',
    },
  },
  potentialAction: {
    '@type': 'SearchAction',
    target: 'https://szovegelek.promnet.hu/probald?topic={search_term_string}',
    'query-input': 'required name=search_term_string',
  },
};

const softwareSchema = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'Szövegelek',
  applicationCategory: 'BusinessApplication',
  operatingSystem: 'Web',
  description: 'Magyar AI-copywriter SaaS KKV-knek. 9 sablon (termékleírás, FB-hirdetés, e-mail, Instagram, blog, Google Ads, ÁSZF-summary, LinkedIn, sajtóközlemény).',
  inLanguage: 'hu-HU',
  offers: [
    {
      '@type': 'Offer',
      name: 'Free',
      price: 0,
      priceCurrency: 'HUF',
      description: '20 generálás / hó IP-quota',
    },
    {
      '@type': 'Offer',
      name: 'Start',
      price: 2990,
      priceCurrency: 'HUF',
      description: '500 generálás / hó · brand-hang mentés',
    },
    {
      '@type': 'Offer',
      name: 'Pro',
      price: 9990,
      priceCurrency: 'HUF',
      description: 'Korlátlan generálás · CSV bulk · 5 user csapat · API',
    },
  ],
  aggregateRating: undefined, // még nincs review
};
---

<!doctype html>
<html lang="hu">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#e44a6b" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    {/* Favicon-pack — SVG (skálázódik) + Apple-touch */}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/favicon.svg" />
    <link rel="mask-icon" href="/favicon.svg" color="#e44a6b" />

    {/* Google Fonts — Plus Jakarta Sans + Lora */}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet"
          href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=Lora:ital,wght@1,500;1,600&display=swap" />

    {/* Open Graph (Facebook / LinkedIn / Slack / Discord) */}
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={articleSchema ? 'article' : 'website'} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="Szövegelek" />
    <meta property="og:locale" content="hu_HU" />
    <meta property="og:image" content={ogImageAbsolute} />
    <meta property="og:image:width" content="1024" />
    <meta property="og:image:height" content="1024" />
    <meta property="og:image:alt" content="Szövegelek — magyar AI-copywriter SaaS" />

    {/* Twitter Card */}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageAbsolute} />
    <meta name="twitter:image:alt" content="Szövegelek — magyar AI-copywriter" />

    {/* SEO meta plus */}
    <meta name="robots" content="index, follow, max-image-preview:large" />
    <meta name="author" content="Polyák Csaba e.v." />
    <meta name="keywords" content="magyar AI copywriter, termékleírás generátor, hirdetés szöveg AI, magyar Llama, KKV szövegírás, AI marketing, magyar copywriting" />
    <meta name="format-detection" content="telephone=no" />

    {/* Schema.org JSON-LD — WebSite + SoftwareApplication */}
    <script type="application/ld+json" is:inline set:html={JSON.stringify(websiteSchema)} />
    <script type="application/ld+json" is:inline set:html={JSON.stringify(softwareSchema)} />
    {articleSchema && (
      <script type="application/ld+json" is:inline set:html={JSON.stringify(articleSchema)} />
    )}

    {/* Cross-brand related links — Google felfedezi a SaaS-családot */}
    <link rel="alternate" type="application/json+oembed"
          href="https://szovegelek.promnet.hu/oembed.json" />
  </head>
  <body class="antialiased min-h-screen">
    <header class="bg-white border-b border-sz-border sticky top-0 z-30">
      <div class="max-w-6xl mx-auto px-4 py-3 flex items-center justify-between gap-4">
        <Logo size="md" />
        <nav class="hidden md:flex items-center gap-5 text-sm">
          <a href="/eszkozok" class="text-sz-text-mid hover:text-sz-accent transition-colors">Eszközök</a>
          <a href="/blog" class="text-sz-text-mid hover:text-sz-accent transition-colors">Blog</a>
          <a href="/#arak" class="text-sz-text-mid hover:text-sz-accent transition-colors">Árak</a>
        </nav>
        <div class="flex items-center gap-2">
          {user ? (
            <>
              <span class="hidden sm:flex items-center gap-1.5 text-xs text-sz-text-mid bg-sz-bg-2 border border-sz-border px-2.5 py-1.5 rounded-full">
                <span class="w-1.5 h-1.5 rounded-full bg-sz-success sz-pulse-soft"></span>
                {user.display_name ?? user.email.split('@')[0]}
              </span>
              <a href="/probald" class="sz-btn-primary text-sm">
                Generálj →
              </a>
            </>
          ) : (
            <>
              <a href={PN_LOGIN_BRIDGE} class="hidden sm:inline-flex text-sm text-sz-text-mid hover:text-sz-accent px-3 py-2 transition-colors">
                Belépés
              </a>
              <a href="/probald" class="sz-btn-primary text-sm">
                Próbáld ingyen →
              </a>
            </>
          )}
        </div>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="bg-white border-t border-sz-border mt-16">
      <div class="max-w-6xl mx-auto px-4 py-8 text-sm">
        <div class="flex flex-wrap items-start justify-between gap-6">
          <div>
            <Logo size="sm" />
            <p class="text-xs text-sz-text-dim max-w-md leading-relaxed mt-3">
              Magyar AI-copywriter KKV-knek. Termékleírás, hirdetés-szöveg, e-mail-vázlat
              — magyar nyelven, percek alatt. A PromNET-család tagja.
            </p>
          </div>
          <div class="text-xs text-sz-text-dim space-y-1">
            <p class="font-semibold text-sz-text-mid mb-1.5">SaaS-család</p>
            <a href="https://navbot.hu" class="block hover:text-sz-accent transition-colors" rel="noopener">
              🛒 NavBot.hu — webshop, NAV-számla, helpdesk
            </a>
            <a href="https://promnet.hu" class="block hover:text-sz-accent transition-colors" rel="noopener">
              ☁️ PromNET.hu — magyar Cloudflare-rátét
            </a>
          </div>
        </div>
        <div class="border-t border-sz-border mt-6 pt-4 flex flex-wrap items-center justify-between gap-3 text-[11px] text-sz-text-muted">
          <span>© 2026 Szövegelek (PromNET-család) — Polyák Csaba e.v.</span>
          <span class="font-mono">Magyar fejlesztő · CF-Pages · Workers AI</span>
        </div>
      </div>
    </footer>
  </body>
</html>
