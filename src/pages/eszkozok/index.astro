---
import Base from '../../layouts/Base.astro';
import { TOOLS } from '../../data/tools';
---

<Base
  title="9 magyar AI-szöveg-tool — Szövegelek"
  description="Termékleírás, FB-hirdetés, e-mail, Instagram, blog-vázlat, Google Ads, ÁSZF-summary, LinkedIn, sajtóközlemény — magyar AI-copywriter 9 sablonnal. KKV-knek szabva, szerves magyar nyelven."
>
  <section class="bg-gradient-to-b from-sz-bg-3 to-sz-bg">
    <div class="max-w-5xl mx-auto px-4 pt-12 pb-10 text-center">
      <p class="font-mono text-xs text-sz-accent uppercase tracking-wider mb-3 sz-fade-up">9 SABLON · MAGYAR</p>
      <h1 class="text-3xl md:text-5xl font-bold tracking-tight mb-4 text-sz-text sz-fade-up-1">
        Magyar AI-copywriter eszközök
      </h1>
      <p class="text-lg text-sz-text-mid max-w-2xl mx-auto sz-fade-up-2">
        9 sablon a magyar SMB-piacra szabva. Mindegyik 5 mp alatt 3 verziót generál
        — szerves magyar mondatokkal, NEM ChatGPT-stílus.
      </p>
    </div>
  </section>

  <section class="max-w-5xl mx-auto px-4 py-12">
    <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-4">
      {TOOLS.map((t) => (
        <a href={`/eszkozok/${t.slug}`} class="sz-card hover:border-sz-accent transition-all hover:-translate-y-0.5 group">
          <div class="text-3xl mb-3 group-hover:scale-110 transition-transform inline-block">{t.emoji}</div>
          <h2 class="font-bold text-base mb-1.5 text-sz-text group-hover:text-sz-accent transition-colors">
            {t.title}
          </h2>
          <p class="text-sm text-sz-text-mid leading-relaxed mb-3">
            {t.lead}
          </p>
          <span class="text-xs text-sz-accent font-mono">Részletek →</span>
        </a>
      ))}
    </div>

    <div class="mt-10 text-center">
      <a href="/probald" class="sz-btn-primary px-6 py-3">
        Vagy próbáld ki most →
      </a>
    </div>
  </section>
</Base>
