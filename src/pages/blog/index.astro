---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog'))
  .filter((p) => !p.data.draft)
  .sort((a, b) => b.data.publishedAt.localeCompare(a.data.publishedAt));

const fmtDate = (iso: string) =>
  new Date(iso).toLocaleDateString('hu-HU', { year: 'numeric', month: 'long', day: 'numeric' });
---

<Base
  title="Magyar copywriting blog — Szövegelek"
  description="Magyar AI-copywriter cikkek KKV-knek: termékleírás, FB-hirdetés, e-mail tárgy-sor, Instagram caption, ÁSZF-tippek. Konkrét példák magyar SMB-piacra."
>
  <section class="bg-gradient-to-b from-sz-bg-3 to-sz-bg">
    <div class="max-w-4xl mx-auto px-4 pt-12 pb-10 text-center">
      <p class="font-mono text-xs text-sz-accent uppercase tracking-wider mb-3 sz-fade-up">blog</p>
      <h1 class="text-3xl md:text-5xl font-bold tracking-tight mb-4 text-sz-text sz-fade-up-1">
        Magyar copywriting tippek
      </h1>
      <p class="text-lg text-sz-text-mid max-w-2xl mx-auto sz-fade-up-2">
        Konkrét példák magyar webshopnak, KKV-knek. Termékleírás, hirdetés-szöveg,
        e-mail, Instagram, ÁSZF — mind magyar piacra szabva.
      </p>
    </div>
  </section>

  <section class="max-w-4xl mx-auto px-4 py-12">
    <div class="space-y-4">
      {posts.map((post) => (
        <a href={`/blog/${post.slug}`}
           class="sz-card hover:border-sz-accent transition-all hover:-translate-y-0.5 group block">
          <div class="flex items-baseline gap-3 mb-2 flex-wrap">
            <time datetime={post.data.publishedAt}
                  class="text-[10px] font-mono uppercase tracking-wider text-sz-text-muted">
              {fmtDate(post.data.publishedAt)}
            </time>
            <span class="text-[10px] font-mono text-sz-text-muted">·</span>
            <span class="text-[10px] font-mono text-sz-text-muted">{post.data.readingMinutes} perc olvasás</span>
            {post.data.tags.length > 0 && (
              <>
                <span class="text-[10px] font-mono text-sz-text-muted">·</span>
                <div class="flex gap-1.5 flex-wrap">
                  {post.data.tags.slice(0, 3).map((t) => (
                    <span class="text-[10px] font-mono px-1.5 py-0.5 bg-sz-accent-l text-sz-accent rounded">
                      #{t}
                    </span>
                  ))}
                </div>
              </>
            )}
          </div>
          <h2 class="font-bold text-xl text-sz-text mb-1.5 group-hover:text-sz-accent transition-colors leading-tight">
            {post.data.title}
          </h2>
          <p class="text-sm text-sz-text-mid leading-relaxed">
            {post.data.description}
          </p>
          <span class="text-xs text-sz-accent font-mono mt-3 inline-block">Olvasom →</span>
        </a>
      ))}
    </div>

    {posts.length === 0 && (
      <div class="text-center py-16 text-sz-text-dim">
        Még nincs poszt — hamarosan!
      </div>
    )}
  </section>

  <section class="bg-sz-bg-2 border-y border-sz-border">
    <div class="max-w-3xl mx-auto px-4 py-12 text-center">
      <h2 class="text-2xl md:text-3xl font-bold mb-3 text-sz-text">
        Olvastad — most <span class="serif italic text-sz-accent">próbáld ki</span>
      </h2>
      <p class="text-sm text-sz-text-mid mb-6">
        9 sablon a magyar SMB-piacra szabva, 5 mp alatt 3 verzió.
      </p>
      <a href="/probald" class="sz-btn-primary px-6 py-3">
        Generálj most →
      </a>
    </div>
  </section>
</Base>
